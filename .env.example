# Copy to .env.local and fill in. `supabase start` prints these values.
#
# Local development against `supabase start` uses the defaults below verbatim —
# the anon key is the same for every local Supabase instance and is not secret.

# The Supabase API URL. Local default:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon (publishable) key. Safe to expose to the browser; row-level security
# is what protects the data. Take the value `supabase start` prints as
# "anon key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the deployment, used for canonical and Open Graph URLs.
# Optional: defaults to the production domain in src/lib/site.ts. Set it on
# preview deployments and while DNS for barntillväxt.se is still pending, so
# link previews resolve. Punycode, not Unicode.
NEXT_PUBLIC_SITE_URL=

# Direct Postgres connection, used only by `npm run db:test`. Local default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
